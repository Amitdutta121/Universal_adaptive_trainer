# Adaptive Trainer configuration.
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# Every value below is optional; the defaults are the ones used when the file is absent.

# ---------------------------------------------------------------------------
# Development / runtime settings
# ---------------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. Default is a local SQLite file under ./data/.
DATABASE_URL=sqlite:///./data/adaptive_trainer.db
# Log every SQL statement (very verbose; development only).
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# LLM provider (used by curriculum proposal; later by question generation)
# ---------------------------------------------------------------------------
# anthropic | openai | openrouter | none
LLM_PROVIDER=openrouter
# The model name must match the provider:
#   anthropic  -> claude-sonnet-5
#   openai     -> gpt-4.1
#   openrouter -> a namespaced route, e.g. deepseek/deepseek-chat
# DeepSeek V3 (deepseek/deepseek-chat) is the default: it is inexpensive and
# non-reasoning, so the whole output budget goes to the answer. A reasoning model
# such as deepseek/deepseek-r1 spends part of LLM_MAX_OUTPUT_TOKENS on hidden
# reasoning tokens and needs that budget raised before it will fit a full reply.
LLM_MODEL=deepseek/deepseek-chat
# Leave empty to run the app without LLM features. Never commit a real key.
# OpenRouter keys start with `sk-or-v1-`.
LLM_API_KEY=
# Optional override for self-hosted or proxied endpoints. Leave empty to use the
# provider's own endpoint (OpenRouter: https://openrouter.ai/api/v1).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Book ingestion
# ---------------------------------------------------------------------------
# Directory where uploaded book documents are retained.
BOOK_UPLOAD_DIR=./data/books
MAX_BOOK_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Curriculum proposal
# ---------------------------------------------------------------------------
# Section analysis is one LLM call per section, so an unbounded run over several
# textbooks is a large, silent bill. Sections beyond this limit are skipped, and
# the skip is reported on the resulting curriculum version.
CURRICULUM_MAX_SECTIONS=150
# Characters of section text sent for analysis. Truncation is for the model's
# context window only: the stored section is never altered.
CURRICULUM_SECTION_CHAR_BUDGET=6000
