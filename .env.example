# Adaptive Trainer configuration.
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# Every value below is optional; the defaults are the ones used when the file is absent.

# ---------------------------------------------------------------------------
# Development / runtime settings
# ---------------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. Default is a local SQLite file under ./data/.
DATABASE_URL=sqlite:///./data/adaptive_trainer.db
# Log every SQL statement (very verbose; development only).
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# LLM provider (reserved for question generation)
# ---------------------------------------------------------------------------
# openrouter | none
LLM_PROVIDER=openrouter
# OpenRouter route, e.g. deepseek/deepseek-chat or deepseek/deepseek-r1
LLM_MODEL=deepseek/deepseek-chat
# Leave empty to run the app without LLM features. Never commit a real key.
# OpenRouter keys start with `sk-or-v1-`.
LLM_API_KEY=
# Optional override for self-hosted or proxied endpoints. Leave empty to use the
# provider's own endpoint (OpenRouter: https://openrouter.ai/api/v1).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# OpenRouter embedding route for review-example retrieval (personalization).
EMBEDDING_MODEL=
# Seconds a generated snippet may run during deterministic validation.
VALIDATION_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------------------
# Bulk judge re-run (ADR-030)
# ---------------------------------------------------------------------------
# Re-judges the whole question bank as an asynchronous provider batch job at
# roughly half the synchronous token price. Off by default: a run costs real
# money and completes over hours rather than seconds. There is no scheduler --
# results are collected by pressing "Check for results" on the Questions page.
JUDGE_BATCH_ENABLED=false
# OpenRouter's batch jobs live under /api/beta, not the /api/v1 path the
# synchronous client uses. Override only for a proxy.
JUDGE_BATCH_BASE_URL=https://openrouter.ai/api/beta
# Leave empty to judge with LLM_MODEL. Set to name a cheaper batch-only route.
JUDGE_BATCH_MODEL=
# Leave empty to authenticate with LLM_API_KEY. Never commit a real key.
JUDGE_BATCH_API_KEY=
# Requests per provider job; a larger bank is split across several jobs that
# share one run id.
JUDGE_BATCH_MAX_REQUESTS_PER_JOB=200
JUDGE_BATCH_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Book ingestion
# ---------------------------------------------------------------------------
# Directory where uploaded book documents are retained.
BOOK_UPLOAD_DIR=./data/books
MAX_BOOK_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Auth (Instructor Studio login)
# ---------------------------------------------------------------------------
# Signs password-reset/verification tokens. Set a real random value for any
# shared or deployed environment -- the default is only safe on a single
# developer's own machine.
AUTH_SECRET_KEY=dev-only-insecure-secret-change-me
# The one seeded professor account. Only ever created when ENVIRONMENT=development;
# a production run never seeds a credential automatically.
DEV_USER_EMAIL=dev@local.test
DEV_USER_PASSWORD=devpassword123

# ---------------------------------------------------------------------------
# Browser clients (CORS)
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call /api from a browser, for a
# React front end served from its own dev server or host. Empty disables CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
