# Frontend configuration. Copy to `.env.local` (git-ignored) and adjust.
#
# Only the Next.js server reads this. The browser talks to `/api/*` on its own
# origin and `next.config.ts` forwards those requests to FastAPI, so the backend
# URL never reaches the client bundle and CORS is never involved in development.
#
# Start the backend first:  .\.venv\Scripts\python.exe -m app
API_ORIGIN=http://127.0.0.1:8000
