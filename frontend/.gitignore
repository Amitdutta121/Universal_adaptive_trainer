# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the documented template is committed.
!.env.example

# Intermediate OpenAPI dump. The compiled types (src/lib/api/schema.d.ts) ARE
# committed, so `pnpm build` works without a Python environment; regenerate both
# with `pnpm run api:types` whenever a backend schema changes.
/openapi.json
