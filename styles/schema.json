{
  "$defs": {
    "ChartData": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "datasets": {
          "items": {
            "$ref": "#/$defs/ChartDataset"
          },
          "minItems": 1,
          "title": "Datasets",
          "type": "array"
        }
      },
      "required": [
        "datasets"
      ],
      "title": "ChartData",
      "type": "object"
    },
    "ChartDataset": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "$ref": "#/$defs/XYPoint"
              },
              "type": "array"
            }
          ],
          "minLength": 1,
          "title": "Data"
        }
      },
      "required": [
        "label",
        "data"
      ],
      "title": "ChartDataset",
      "type": "object"
    },
    "ChartFigure": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "kind": {
          "const": "chart",
          "title": "Kind",
          "type": "string"
        },
        "chart": {
          "$ref": "#/$defs/ChartSpec"
        }
      },
      "required": [
        "alt",
        "kind",
        "chart"
      ],
      "title": "ChartFigure",
      "type": "object"
    },
    "ChartSpec": {
      "additionalProperties": false,
      "description": "A Chart.js chart as data only: no callbacks, no plugins, no options beyond axis titles.",
      "properties": {
        "type": {
          "enum": [
            "bar",
            "line",
            "pie",
            "doughnut",
            "scatter"
          ],
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ChartData"
        },
        "x_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X Title"
        },
        "y_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y Title"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "ComputedFigure": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "kind": {
          "const": "computed",
          "title": "Kind",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "alt",
        "kind",
        "file"
      ],
      "title": "ComputedFigure",
      "type": "object"
    },
    "DiagramFigure": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "kind": {
          "const": "diagram",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "alt",
        "kind",
        "source"
      ],
      "title": "DiagramFigure",
      "type": "object"
    },
    "Difficulty": {
      "description": "Question difficulty. Selected from student topic mastery.",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "ExampleOption": {
      "description": "One choice of a choice-type example.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "correct": {
          "default": false,
          "title": "Correct",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "ExampleOption",
      "type": "object"
    },
    "ExampleQuestion": {
      "description": "One worked example shown on a style card, answer key included.\n\nMirrors ``ExampleQuestion`` in ``frontend/src/app/experiments/question-setup/mock-types.ts``.",
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ExampleOption"
          },
          "title": "Options",
          "type": "array"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "title": "Lines",
          "type": "array"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "tests": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests"
        },
        "solution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solution"
        },
        "test_cases": {
          "items": {
            "$ref": "#/$defs/ExampleTestCase"
          },
          "title": "Test Cases",
          "type": "array"
        },
        "grounding": {
          "default": "",
          "title": "Grounding",
          "type": "string"
        },
        "figure": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "chart": "#/$defs/ChartFigure",
                  "computed": "#/$defs/ComputedFigure",
                  "diagram": "#/$defs/DiagramFigure"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DiagramFigure"
                },
                {
                  "$ref": "#/$defs/ChartFigure"
                },
                {
                  "$ref": "#/$defs/ComputedFigure"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "ExampleQuestion",
      "type": "object"
    },
    "ExampleTestCase": {
      "description": "One hidden test of a code example. Same shape as a generated question's test case\n(``app.generation.schemas.ExecutableTestCase``), which this pure module cannot import.",
      "properties": {
        "stdin": {
          "default": "",
          "title": "Stdin",
          "type": "string"
        },
        "stdout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stdout"
        },
        "assert": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assert"
        }
      },
      "title": "ExampleTestCase",
      "type": "object"
    },
    "QuestionType": {
      "description": "Assessment format (independent of scoring mode).",
      "enum": [
        "multiple_choice",
        "true_false",
        "output_prediction",
        "code_completion",
        "debugging",
        "parsons",
        "coding",
        "numeric_response",
        "equation_response"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "XYPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "XYPoint",
      "type": "object"
    }
  },
  "description": "One style in a subject's library.\n\n``id`` is stable and namespaced by subject (``py.trace_output``): it is stored on every\nquestion generated in this style and on every approved setup, so renaming a style must not\nchange it.",
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "question_type": {
      "$ref": "#/$defs/QuestionType"
    },
    "difficulty_range": {
      "items": {
        "$ref": "#/$defs/Difficulty"
      },
      "minItems": 1,
      "title": "Difficulty Range",
      "type": "array"
    },
    "checked_by": {
      "title": "Checked By",
      "type": "string"
    },
    "applies_to": {
      "items": {
        "type": "string"
      },
      "title": "Applies To",
      "type": "array"
    },
    "figure": {
      "default": "none",
      "enum": [
        "none",
        "diagram",
        "chart",
        "computed"
      ],
      "title": "Figure",
      "type": "string"
    },
    "examples": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ExampleQuestion"
        },
        {
          "$ref": "#/$defs/ExampleQuestion"
        }
      ],
      "title": "Examples",
      "type": "array"
    }
  },
  "required": [
    "name",
    "summary",
    "question_type",
    "difficulty_range",
    "checked_by",
    "examples"
  ],
  "title": "Question style file",
  "type": "object"
}
